rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function ownsProfile(file) {
      return request.auth != null
        && file.matches('^[A-Za-z0-9]{10}[.]jpg$')
        && firestore.get(/databases/(default)/documents/profiles/$(file.split('[.]')[0])).data.ownerUid == request.auth.uid;
    }

    match /profiles/{file} {
      allow read: if true;
      allow create, update: if ownsProfile(file)
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if ownsProfile(file);
    }

    match /users/{uid}/{all=**} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
