    "expo-sharing": "~57.0.22",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "fuse.js": "^7.5.0",
    "libphonenumber-js": "^1.13.14",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-google-mobile-ads": "^17.2.0",
    "react-native-nfc-manager": "^3.17.5",
